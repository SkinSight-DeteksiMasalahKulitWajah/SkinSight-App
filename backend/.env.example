# Application
PROJECT_NAME="SkinSight API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# CORS (JSON Array of allowed origins, use '["*"]' for local development)
CORS_ORIGINS='["http://localhost:3000", "http://localhost:8080", "*"]'

# Server host & port
HOST="0.0.0.0"
PORT=8000

# Database (Supabase PostgreSQL via asyncpg driver)
# Ganti YOUR_DB_PASSWORD dengan password database Supabase Anda
DATABASE_URL="postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.pzszjjjyrwdfehfwczyo.supabase.co:5432/postgres"

# Supabase Auth & Storage Config
SUPABASE_URL="https://pzszjjjyrwdfehfwczyo.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"

# Machine Learning Service Config
ML_MODEL_PATH="models/skin_classifier.tflite"
USE_MOCK_ML=true
